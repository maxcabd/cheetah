# /restaurant/[id]: a place's page. Its card links here with
# transition="zoom", so on iOS 18+ the page grows out of the card and drags
# back into it. `place` comes from the loader (screens/restaurant.rs).
component RestaurantPage
  column width=-1 height=-1 bg=CARD_BG
    if place.found
      use RestaurantDetails place=place
    else
      column width=-1 height=-1 .center gap=8
        text "This place isn't in your results anymore." size=16 font="satoshi-medium" color=MUTED align="center" width=280 lines=2 height=40
    # Close: back to the card (the page shrinks into it).
    column absolute=true top=place.safe_top left=16 width=44 height=52 justify="end"
      glass key="page:back" pressable=true width=44 height=44 radius=22 glass_style="regular" glass_tint="#00000047" glass_interactive=true label="Close" .center
        use Icon name="chevron.down" size=18 color="#ffffff"

component RestaurantDetails
  column width=-1 height=-1
    # The photo's bottom blurs into the page (a blur fading in from clear),
    # under a light colour fade; same background as the card.
    column width=-1 height=PAGE_PHOTO
      native "photo" key="page-photo:{place.id}" absolute=true top=0 left=0 width=-1 height=PAGE_PHOTO native_props=place.photo_props
      native "blur" absolute=true bottom=0 left=0 width=-1 height=PAGE_BLUR native_props=PAGE_BLUR_STYLE
      native "gradient" absolute=true bottom=0 left=0 width=-1 height=PAGE_FADE native_props=PAGE_FADE_COLORS
      use PhotoCredit credit=place.credit left=20 bottom=14 width=150
    column width=-1 pad_h=20 pad_v=18 gap=10
      text place.name size=26 font="brice-bold" color=TEXT lines=2
      text place.summary .label color=MUTED lines=1 width=place.inner
      use Hours place=place inner=place.inner fg="#ffffff" muted="#ffffffb3"
      # In a full-width row, so the column doesn't stretch the pill.
      if place.has_rating
        row width=-1 height=30
          row height=30 pad_h=12 gap=8 radius=15 border=1 border_color="#404040" align_items="center"
            row width=16 height=16 radius=8 bg="#ffffff" .center
              use Icon name="google" size=9 color="#4285F4"
            text place.rating size=12 font="satoshi-medium" color="#ffffff" bold=true lines=1
      if place.address
        row width=place.inner gap=8 align_items="center" height=20
          use Icon name="mappin.and.ellipse" size=14 color=MUTED
          text place.address .label color=TEXT lines=1
      if place.has_pills
        row width=place.inner wrap=true gap=8
          if place.diet
            use DietPill label=place.diet height=32 pad=12 icon_size=13 text_size=13
          for amenity in place.amenities
            use Amenity id=amenity height=32 pad=12 icon_size=13 text_size=13
      # Directions (Apple or Google Maps), share, bookmark: Liquid Glass on
      # iOS 26, a blur before.
      row width=place.inner height=48 gap=10 align_items="center"
        # Which maps app: the iOS menu, from the button (GlassMenu); or
        # straight to the one picked in Settings.
        if place.ask_maps
          row width=place.directions_width height=48
            glass width=place.directions_width height=48 radius=24 glass_style="regular" glass_tint="#00000047" .center
              use DirectionsLabel
            native "menu" key="page:directions" absolute=true top=0 left=0 width=place.directions_width height=48 label="Directions" native_props=place.directions_menu
        else
          glass key="page:directions" pressable=true width=place.directions_width height=48 radius=24 glass_style="regular" glass_tint="#00000047" glass_interactive=true label="Directions" .center
            use DirectionsLabel
        glass key="page:share" pressable=true width=48 height=48 radius=24 glass_style="regular" glass_tint="#00000047" glass_interactive=true label="Share" .center
          use Icon name="square.and.arrow.up" size=17 color="#ffffff"
        glass key="page:bookmark" pressable=true width=48 height=48 radius=24 glass_style="regular" glass_tint="#00000047" glass_interactive=true label="Save" .center
          use Icon name=place.saved ? "bookmark.fill" : "bookmark" size=17 color="#ffffff"

component DirectionsLabel
  row height=48 gap=8 align_items="center"
    use Icon name="arrow.triangle.turn.up.right.diamond.fill" size=16 color="#ffffff"
    text "Directions" size=15 font="satoshi-bold" bold=true color="#ffffff" lines=1
