# /settings: location access, where searches work, and the version
# (screens/settings.rs). Opened from the drawer.
component SettingsPage
  column width=-1 height=-1 bg=CARD_BG
    column width=-1 height=settings.safe_top
    row width=-1 height=52 pad_h=16 gap=12 align_items="center"
      glass key="page:back" pressable=true width=44 height=44 radius=22 glass_style="regular" glass_tint="#00000047" glass_interactive=true label="Close" .center
        use Icon name="chevron.down" size=18 color="#ffffff"
      text "Settings" size=26 font="brice-bold" color=TEXT weight=1 lines=1 height=32
    column width=-1 pad_h=20 pad_v=16 gap=12
      # Location: whether it's on, and a way to turn it on.
      column width=-1 pad=16 gap=10 radius=20 .chip_frame
        row width=-1 height=22 gap=12 align_items="center"
          use Icon name=settings.location_icon size=17 color="#ffffff"
          text "Location" size=16 font="satoshi-bold" color="#ffffff" weight=1 lines=1 height=22
          text settings.location_status key="settings:location-status" size=15 font="satoshi-medium" color=MUTED lines=1 height=20
        text settings.location_detail size=14 font="satoshi-medium" color=MUTED lines=2 height=36
        if settings.location_off
          row width=-1 height=40
            row key="settings:location" pressable=true height=40 pad_h=16 radius=20 bg="#ffffff" align_items="center" label="Open Settings"
              text "Open Settings" size=15 font="satoshi-bold" color="#111111" lines=1
      # Where searches work.
      column width=-1 pad=16 gap=6 radius=20 .chip_frame
        row width=-1 height=22 gap=12 align_items="center"
          use Icon name="map" size=17 color="#ffffff"
          text "Where Nightshade works" size=16 font="satoshi-bold" color="#ffffff" weight=1 lines=1 height=22
        text settings.coverage size=14 font="satoshi-medium" color=MUTED lines=2 height=36
      text settings.version key="settings:version" size=13 font="satoshi-medium" color=MUTED align="center" width=-1 lines=1 height=18
