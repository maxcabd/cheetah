# Colors and sizes for the .view files. Rust layout math (sheet height) uses
# theme.rs; keep the shared sizes in step.
const BG = "#0b0b0f"
const SHEET_BG = "#171717"
const CLEAR = "#00000000"
const CARD_BG = "#1f1f1f"
const CHIP_BG = "#242424"
const TEXT = "#f5f5f5"
const MUTED = "#a3a3a3"
const GREEN = "#4ade80"
const RED = "#f87171"
const SEARCH_HEIGHT = 52
const SEARCH_BOTTOM_GAP = 4
# Cards sit above the results sheet; keep CAROUSEL_BOTTOM and CARD_HEIGHT in
# step with theme.rs, which fits the map's pins above them.
const CAROUSEL_BOTTOM = 224
const CARD_HEIGHT = 320
const CARD_HEADER = 180
const CARD_BODY = 140

# Shared attribute sets: `.name` on an element; later attributes override.
style center = align_items="center" justify="center"
style label = size=14 font="satoshi-medium" color="#ffffff" height=18
style line = height=18 gap=4 align_items="center"
style heading = size=20 font="brice-semibold" line_height=26 color=TEXT height=26
style sheet_body = width=-1 weight=1 pad_h=24
style chip_frame = bg=CHIP_BG border=1 border_color="#ffffff14"
