# Colors and sizes for the .view files. Rust layout math (sheet height) uses
# theme.rs; keep the shared sizes in step.
const BG = "#0b0b0f"
const SHEET_BG = "#171717"
const CLEAR = "#00000000"
const CARD_BG = "#1f1f1f"
const CHIP_BG = "#242424"
const TEXT = "#f5f5f5"
const MUTED = "#a3a3a3"
const GREEN = "#4ade80"
# iOS Settings in dark mode: the page, its groups, values and hairlines.
const SETTINGS_BG = "#000000"
const SETTINGS_ROW = "#1c1c1e"
const SETTINGS_MUTED = "#8e8e93"
const SETTINGS_LINE = "#38383a"
const RED = "#f87171"
# The AI overview card and ask bar: a soft violet, apart from the reds.
const AI_TINT = "#c4b5fd"
# Below a place page's content: room for its floating ask bar.
const ASK_BAR_ROOM = 96
const SEARCH_HEIGHT = 52
const SEARCH_BOTTOM_GAP = 4
# Cards sit above the results sheet; keep CAROUSEL_BOTTOM and CARD_HEIGHT in
# step with theme.rs, which fits the map's pins above them.
const CAROUSEL_BOTTOM = 224
const CARD_HEIGHT = 280
# A minimized card (theme.rs MINI_CARD_HEIGHT).
const MINI_CARD_HEIGHT = 72
const CARD_HEADER = 148
const CARD_BODY = 132
# The photo gallery at the top of a place's page.
const PAGE_PHOTO = 320
# Where a page's photo meets the page (CARD_BG): a blur fading in from
# clear, and over it a light colour fade.
const PAGE_BLUR = 150
const PAGE_BLUR_STYLE = "{{\"style\":\"dark\",\"fade\":\"top\"}}"
const PAGE_FADE = 90
const PAGE_FADE_COLORS = "{{\"colors\":[\"#1f1f1f00\",\"#1f1f1f40\",\"#1f1f1fa6\"],\"locations\":[0,0.6,1],\"startY\":0,\"endY\":1}}"

# Shared attribute sets: `.name` on an element; later attributes override.
style center = align_items="center" justify="center"
style label = size=14 font="satoshi-medium" color="#ffffff" height=18
style line = height=18 gap=4 align_items="center"
style heading = size=20 font="brice-semibold" line_height=26 color=TEXT height=26
style sheet_body = width=-1 weight=1 pad_h=24
style chip_frame = bg=CHIP_BG border=1 border_color="#ffffff14"
