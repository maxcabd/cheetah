# Small shared pieces: icons, chips, buttons.

component Icon
  native "icon" native_props="{{\"name\":\"{name}\",\"color\":\"{color}\"}}" width=size height=size size=size color=color

component GlassIcon
  glass key=key pressable=true width=38 height=38 radius=19 glass_style="regular" glass_tint="#00000047" glass_interactive=true .center
    use Icon name=icon size=16 color="#ffffff"

# GlassIcon that opens the iOS menu, anchored to the button (above it, when
# the button sits low): the native menu takes the tap, over the glass.
# `items` is the menu's native_props, {"items": [...]}; a pick sends
# `select` with the item's title.
component GlassMenu
  row width=38 height=38
    glass width=38 height=38 radius=19 glass_style="regular" glass_tint="#00000047" .center
      use Icon name=icon size=16 color="#ffffff"
    native "menu" key=key absolute=true top=0 left=0 width=38 height=38 label=label native_props=items

# "Photo: <name>" over the photo it credits, at its bottom left: Google
# requires its photos' credits be shown with them. `credit` is
# {text, key} from `photo_credit` (follows the pager's page); a tap opens
# the photographer's profile. Nothing when the photo needs no credit.
component PhotoCredit
  if credit.text
    text credit.text key=credit.key pressable=true absolute=true left=left bottom=bottom width=width size=11 font="satoshi-medium" color="#ffffffd9" lines=1 height=14 label=credit.text

# Round icon button; `radius` is half of `size`.
component ActionButton
  row key=key pressable=true width=size height=size radius=radius bg=bg .center label=label
    use Icon name=icon size=16 color="#ffffff"

# A pressable suggestion pill, as wide as its label: no width, so the
# layout measures the text. `bold` makes the measurement use bold text,
# close to Satoshi Bold (measuring ignores `font`); the padding absorbs the
# rest, so the label is never cut off. Text centered both ways. Liquid Glass
# on iOS 26 (`glass`), a solid pill before.
component Chip
  if glass
    glass key=key pressable=true height=42 pad_h=16 radius=18 glass_style="regular" glass_interactive=true .center
      text label size=14 font="satoshi-bold" bold=true color="#ffffff" lines=1 align="center"
  else
    text label key=key pressable=true size=14 font="satoshi-bold" bold=true color="#ffffff" .chip_frame pad_h=16 height=42 lines=1 align="center" radius=18
