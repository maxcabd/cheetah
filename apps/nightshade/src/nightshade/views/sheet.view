# Bottom sheet: grabber, body, search bar. On iOS 26 (`glass`) the system's
# Liquid Glass sheet shows through instead of SHEET_BG.
#
# native_props configures the native sheet: two detents iOS drags between
# (it reports where the user left it as `select`), the search bar kept above
# the keyboard, background, system grabber (off: the grabber row below is
# ours), and corner radius. The contents animate with the sheet.

component Sheet
  sheet key="search-panel" absolute=true bottom=0 left=0 width=-1 height=sheet.height radius=54 clip=true bg=sheet.glass ? CLEAR : SHEET_BG native_props="{{\"background\":\"#171717\",\"grabber\":false,\"cornerRadius\":54,\"keyboardView\":\"cheetah-search-bar\",\"keyboardGap\":12,\"detents\":[{{\"id\":\"rest\",\"height\":{sheet.rest_height}}},{{\"id\":\"expanded\",\"height\":{sheet.expanded_height}}}],\"selected\":\"{sheet.detent}\"}}"
    column width=-1 height=sheet.height animate=true transition_ms=380 spring=true
      row key="sheet:toggle" pressable=true width=-1 height=24 .center
        row width=30 height=6 bg="#404040" radius=3
      column width=-1 height=sheet.body_height clip=true animate=true transition_ms=380 spring=true
        if sheet.body == "collapsed"
          column width=-1 height=sheet.body_height
        if sheet.body == "results"
          use ResultsBody query=sheet.query notice=sheet.notice followups=sheet.followups show_followups=sheet.show_followups glass=sheet.glass
        if sheet.body == "searching"
          use SearchingBody query=sheet.query emoji=sheet.searching_emoji
        if sheet.body == "empty"
          use EmptyBody suggestions=sheet.suggestions saved_count=sheet.saved_count glass=sheet.glass
        if sheet.body == "failed"
          use FailedBody query=sheet.query failure=sheet.failure glass=sheet.glass
        if sheet.body == "no_results"
          use NoResultsBody query=sheet.query notice=sheet.notice chips=sheet.other_searches glass=sheet.glass
      use SearchBar placeholder=sheet.placeholder draft=sheet.draft can_send=sheet.can_send can_clear=sheet.can_clear glass=sheet.glass field_key=sheet.field_key
      column width=-1 height=sheet.bottom_gap

component SearchBar
  column width=-1 height=SEARCH_HEIGHT pad_h=24 justify="end" test_id="cheetah-search-bar" animate=true transition_ms=380 spring=true
    row width=-1 height=SEARCH_HEIGHT gap=12 align_items="center"
      # Liquid Glass field on iOS 26; a solid pill elsewhere.
      # Not interactive: the press effect spreads to the whole glass sheet
      # instead of the tap going to the field.
      if glass
        glass weight=1 height=SEARCH_HEIGHT radius=26 glass_style="regular" align_items="center"
          use SearchField placeholder=placeholder draft=draft can_send=can_send field_key=field_key
      else
        row weight=1 height=SEARCH_HEIGHT bg=CHIP_BG border=1 border_color="#2d2d2d" radius=26 align_items="center"
          use SearchField placeholder=placeholder draft=draft can_send=can_send field_key=field_key
      # Clear: Liquid Glass beside the glass field on iOS 26, solid before.
      if can_clear
        if glass
          glass key="search:clear" pressable=true width=44 height=44 radius=22 glass_style="regular" glass_interactive=true label="Clear" .center
            use Icon name="xmark" size=16 color="#ffffff"
        else
          use ActionButton icon="xmark" key="search:clear" bg=CHIP_BG size=44 radius=22 label="Clear"

# Full width: inside glass (a centered column) `weight` only sets height,
# and the row would shrink to its icon, leaving no room for text.
# `field_key` changes on send; the remount dismisses the keyboard.
component SearchField
  row key=field_key width=-1 weight=1 height=SEARCH_HEIGHT align_items="center"
    input placeholder draft key="search" weight=1 height=48 size=16 font="satoshi-medium" color="#ffffff" placeholder_color="#a3a3a3" pad_h=20 align="start"
    # Like iMessage: a voice waveform while empty, a send arrow once typing.
    if can_send
      use ActionButton icon="arrow-up" key="search:send" bg="#dc2626" size=36 radius=18
    else
      row key="search:voice" width=36 height=36 .center
        use Icon name="waveform" size=18 color="#a3a3a3"
    # Keeps the button inside the pill's rounded end.
    column width=8 height=36

# No search yet: heading and suggestion chips.
# The chips scroll edge to edge; their inset lives inside the scroll so the
# first column lines up with the heading.
component EmptyBody
  column width=-1 weight=1 gap=14
    # With something saved, the saved list's way in sits beside the heading.
    if saved_count
      row width=-1 height=36 pad_h=24 justify="space-between" align_items="center"
        text "Ready to discover?" .heading
        use SavedChip glass=glass
    else
      text "Ready to discover?" .heading pad_h=24
    hscroll width=-1 height=200 content_width=648
      column width=648 height=200 pad_h=24 justify="center"
        row width=600 wrap=true gap=10 align_items="center"
          for chip in suggestions
            use Chip label=chip.label key=chip.key glass=glass

component ResultsBody
  column .sheet_body gap=8
    text query .heading
    # The backend's notice when the results don't fully match (a relaxed
    # dietary filter), else the usual line.
    text notice ? notice : "Alright, here's what I'd check out if I were you." size=16 font="satoshi-medium" line_height=20 color=MUTED lines=2 height=notice ? 40 : 20
    # Sized by its label (one line, measured: no fixed width to spill out of),
    # with even padding, so label and chevron sit centered. The outer row
    # keeps the column from stretching the chip to full width. Liquid Glass
    # on iOS 26, a solid pill before.
    row width=-1 height=40
      if glass
        glass key="show-on-map" pressable=true height=40 pad_h=18 radius=18 glass_style="regular" glass_interactive=true .center
          row height=40 gap=8 align_items="center"
            use ShowOnMapLabel
      else
        row key="show-on-map" pressable=true height=40 pad_h=18 gap=8 radius=18 .chip_frame align_items="center" justify="center"
          use ShowOnMapLabel
    if show_followups
      row width=-1 wrap=true gap=10
        for chip in followups
          use Chip label=chip.label key=chip.key glass=glass

component ShowOnMapLabel
  text "Show on map" .label bold=true lines=1 align="center"
  use Icon name="chevron-right" size=12 color="#ffffff"

# Opens the saved list (/saved). Liquid Glass on iOS 26, a solid pill before.
component SavedChip
  if glass
    glass key="sheet:saved" pressable=true height=36 pad_h=14 radius=18 glass_style="regular" glass_interactive=true label="Saved" .center
      row height=36 gap=6 align_items="center"
        use SavedChipLabel
  else
    row key="sheet:saved" pressable=true height=36 pad_h=14 gap=6 radius=18 .chip_frame align_items="center" label="Saved"
      use SavedChipLabel

component SavedChipLabel
  use Icon name="bookmark.fill" size=13 color="#ffffff"
  text "Saved" size=14 font="satoshi-bold" bold=true color="#ffffff" lines=1

# A search that failed (offline, timed out, the server): what went wrong,
# and the same search again.
component FailedBody
  column .sheet_body gap=10
    text query .heading lines=1
    text failure key="search:failure" size=16 font="satoshi-medium" line_height=20 color=MUTED lines=2 height=40
    row width=-1 height=42
      use Chip label="Try again" key="search:retry" glass=glass

# A search that found nothing: other searches to try, scrolling edge to
# edge like the suggestions.
component NoResultsBody
  column width=-1 weight=1 gap=10
    column width=-1 pad_h=24 gap=10
      text query .heading lines=1
      # The backend's reason when it has one ("No taco spots nearby are
      # labelled halal."), else the usual line.
      text notice ? notice : "Nothing nearby matched that. Try one of these:" key="search:none" size=16 font="satoshi-medium" line_height=20 color=MUTED lines=2 height=notice ? 40 : 20
    hscroll width=-1 height=96 content_width=648
      column width=648 height=96 pad_h=24 justify="center"
        row width=600 wrap=true gap=10 align_items="center"
          for chip in chips
            use Chip label=chip.label key=chip.key glass=glass

component SearchingBody
  column .sheet_body gap=10
    text query size=20 font="brice-semibold" color="#ffffff" height=26
    text emoji size=32 width=48 height=40
