# Bottom sheet: grabber, body, search bar. On iOS 26 (`glass`) the system's
# Liquid Glass sheet shows through instead of SHEET_BG.
#
# native_props configures the native sheet: two detents iOS drags between
# (it reports where the user left it as `select`), the search bar kept above
# the keyboard, background, system grabber (off: the grabber row below is
# ours), and corner radius. The contents animate with the sheet.

component Sheet
  sheet key="search-panel" absolute=true bottom=0 left=0 width=-1 height=sheet.height radius=54 clip=true bg=sheet.glass ? CLEAR : SHEET_BG native_props="{{\"background\":\"#171717\",\"grabber\":false,\"cornerRadius\":54,\"keyboardView\":\"cheetah-search-bar\",\"keyboardGap\":12,\"detents\":[{{\"id\":\"rest\",\"height\":{sheet.rest_height}}},{{\"id\":\"expanded\",\"height\":{sheet.expanded_height}}}],\"selected\":\"{sheet.detent}\"}}"
    column width=-1 height=sheet.height animate=true transition_ms=380 spring=true
      row key="sheet:toggle" pressable=true width=-1 height=24 .center
        row width=30 height=6 bg="#404040" radius=3
      column width=-1 height=sheet.body_height clip=true animate=true transition_ms=380 spring=true
        if sheet.body == "collapsed"
          column width=-1 height=sheet.body_height
        if sheet.body == "results"
          use ResultsBody query=sheet.query followups=sheet.followups show_followups=sheet.show_followups
        if sheet.body == "searching"
          use SearchingBody query=sheet.query emoji=sheet.searching_emoji
        if sheet.body == "empty"
          use EmptyBody suggestions=sheet.suggestions
      use SearchBar placeholder=sheet.placeholder draft=sheet.draft can_send=sheet.can_send results=sheet.results glass=sheet.glass field_key=sheet.field_key
      column width=-1 height=sheet.bottom_gap

component SearchBar
  column width=-1 height=SEARCH_HEIGHT pad_h=24 justify="end" test_id="cheetah-search-bar" animate=true transition_ms=380 spring=true
    row width=-1 height=SEARCH_HEIGHT gap=12 align_items="center"
      # Liquid Glass field on iOS 26; a solid pill elsewhere.
      # Not interactive: the press effect spreads to the whole glass sheet
      # instead of the tap going to the field.
      if glass
        glass weight=1 height=SEARCH_HEIGHT radius=26 glass_style="regular" align_items="center"
          use SearchField placeholder=placeholder draft=draft can_send=can_send field_key=field_key
      else
        row weight=1 height=SEARCH_HEIGHT bg=CHIP_BG border=1 border_color="#2d2d2d" radius=26 align_items="center"
          use SearchField placeholder=placeholder draft=draft can_send=can_send field_key=field_key
      if results
        use ActionButton icon="xmark" key="search:clear" bg=CHIP_BG size=44 radius=22 label="Clear"

# Full width: inside glass (a centered column) `weight` only sets height,
# and the row would shrink to its icon, leaving no room for text.
# `field_key` changes on send; the remount dismisses the keyboard.
component SearchField
  row key=field_key width=-1 weight=1 height=SEARCH_HEIGHT align_items="center"
    input placeholder draft key="search" weight=1 height=48 size=16 font="satoshi-medium" color="#ffffff" placeholder_color="#a3a3a3" pad_h=20 align="start"
    # Like iMessage: a voice waveform while empty, a send arrow once typing.
    if can_send
      use ActionButton icon="arrow-up" key="search:send" bg="#dc2626" size=36 radius=18
    else
      row key="search:voice" width=36 height=36 .center
        use Icon name="waveform" size=18 color="#a3a3a3"
    # Keeps the button inside the pill's rounded end.
    column width=8 height=36

# No search yet: heading and suggestion chips.
# The chips scroll edge to edge; their inset lives inside the scroll so the
# first column lines up with the heading.
component EmptyBody
  column width=-1 weight=1 gap=14
    text "Ready to discover?" .heading pad_h=24
    hscroll width=-1 height=200 content_width=648
      column width=648 height=200 pad_h=24 justify="center"
        row width=600 wrap=true gap=10 align_items="center"
          for chip in suggestions
            use Chip label=chip.label key=chip.key

component ResultsBody
  column .sheet_body gap=8
    text query .heading
    text "Alright, here's what I'd check out if I were you." size=16 font="satoshi-medium" line_height=20 color=MUTED height=20
    row key="show-on-map" pressable=true width=154 height=40 pad_h=16 gap=10 radius=18 .chip_frame align_items="center"
      text "Show on map" .label width=96
      use Icon name="chevron-right" size=12 color="#ffffff"
    if show_followups
      row width=-1 wrap=true gap=10
        for chip in followups
          use Chip label=chip.label key=chip.key

component SearchingBody
  column .sheet_body gap=10
    text query size=20 font="brice-semibold" color="#ffffff" height=26
    text emoji size=32 width=48 height=40
