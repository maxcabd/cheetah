# The map screen: map with markers, result cards, and the search sheet.
component MapScreen
  column width=-1 height=-1 bg=BG
    # Under the map screen, uncovered as it slides aside.
    if drawer.shown
      use Drawer drawer=drawer
    # Everything over the map slides with it; its corners round while it's
    # aside. Square and unclipped the rest of the time: clipping a full
    # screen map costs every frame.
    column key="screen" absolute=true top=0 left=0 width=-1 height=-1 translate_x=drawer.offset radius=drawer.radius clip=drawer.shown animate=drawer.animate transition_ms=450 spring=true
      use MapContent region=region carousel=carousel drawer=drawer
    # Drags that move the map screen sit still above it, outside it: a pan is
    # measured in its parent, which mustn't move with the finger. The
    # slid-aside map closes the drawer (a tap, or a drag back); closed, the
    # map's left edge drags it open.
    if drawer.open
      column key="drawer:close" pressable=true gestures="pan" absolute=true top=0 left=drawer.width width=drawer.rest height=-1 label="Close menu"
    else
      column key="drawer:edge" gestures="pan" absolute=true top=0 left=0 width=14 height=-1
    use Sheet sheet=sheet
    for page in pages
      use PageHost page=page

component MapContent
  map key="map" width=-1 height=-1 bg="#101826" test_id="nightshade-map" map_latitude=region.lat map_longitude=region.lng map_latitude_delta=region.lat_delta map_longitude_delta=region.lng_delta map_dark=true map_shows_user=true native_props=region.satellite ? "{{\"mapType\":\"hybrid\",\"recenter\":{region.recenter}}}" : "{{\"mapType\":\"muted\",\"recenter\":{region.recenter}}}"
    for pin in region.pins
      use MapPin pin=pin
  # Map controls, top right from 8pt under the status bar: street map /
  # satellite (showing the mode it switches to), then locate me (filled
  # while the map follows you). Liquid Glass on iOS 26, a blur before.
  column absolute=true top=region.safe_top right=16 width=48 height=112 gap=8 justify="end"
    use MapButton key="map:type" icon=region.satellite ? "map.fill" : "globe.americas.fill" label=region.satellite ? "Street map" : "Satellite"
    use MapButton key="map:locate" icon=region.locate_icon label="Show my location"
  # The menu: opens the drawer. Level with the street map button.
  column absolute=true top=region.safe_top left=16 width=48 height=112 justify="end"
    use MapButton key="drawer:open" icon="line.3.horizontal" label="Menu"
    column width=48 height=56
  if carousel
    use Carousel carousel=carousel

# A map pin: any child of `map` with map_latitude/map_longitude is placed at
# that coordinate. Glass is Liquid Glass on iOS 26 and a blur before.
component MapButton
  glass key=key pressable=true label=label width=48 height=48 radius=24 glass_style="regular" glass_tint="#00000047" glass_interactive=true .center
    use Icon name=icon size=22 color="#ffffff"

component MapPin
  if pin.state == "selected"
    use TeardropMarker pin=pin w=40 h=48 outer=96 icon_size=17 look=MARKER_RED
  if pin.state == "idle"
    use TeardropMarker pin=pin w=30 h=36 outer=72 icon_size=13 look=MARKER_DARK
  if pin.state == "static"
    use PinGlass pin=pin size=48 radius=24 tint="#ffffff33" ring=1 ring_color="#ffffff59" icon=pin.icon icon_size=22 icon_color=pin.icon_color

component PinGlass
  column key="place:{pin.id}" pressable=true width=size height=size map_latitude=pin.lat map_longitude=pin.lng
    glass width=size height=size radius=radius glass_style="regular" glass_tint=tint border=ring border_color=ring_color .center
      use Icon name=icon size=icon_size color=icon_color

# A result pin: the teardrop from Downloads/marker.jpg as one `shape` (SVG
# path, viewBox 100x120: circle, pinched neck, rounded tip at the bottom
# center) with a fork and knife in the circle. Selected pins are red, the
# rest dark. The tip marks the place: the pin fills the top half of a box
# twice its height (`outer`), which the map centers on the coordinate.
const MARKER_RED = "{{\"path\":\"M85.8 82C93.67 73.2 98 61.8 98 50C98 23.49 76.51 2 50 2C23.49 2 2 23.49 2 50C2 61.8 6.33 73.2 14.2 82C24 91 34 95.5 40 101C43.5 104.5 45.5 110 46.6 115.5Q50 121.5 53.4 115.5C54.5 110 56.5 104.5 60 101C66 95.5 76 91 85.8 82Z\",\"viewBox\":[100,120],\"gradient\":{{\"colors\":[\"#ff4a33\",\"#ec3a25\",\"#c92814\"],\"locations\":[0,0.5,1],\"startX\":0,\"startY\":0,\"endX\":1,\"endY\":1}},\"stroke\":\"#ff8676\",\"strokeWidth\":1.5}}"
const MARKER_DARK = "{{\"path\":\"M85.8 82C93.67 73.2 98 61.8 98 50C98 23.49 76.51 2 50 2C23.49 2 2 23.49 2 50C2 61.8 6.33 73.2 14.2 82C24 91 34 95.5 40 101C43.5 104.5 45.5 110 46.6 115.5Q50 121.5 53.4 115.5C54.5 110 56.5 104.5 60 101C66 95.5 76 91 85.8 82Z\",\"viewBox\":[100,120],\"gradient\":{{\"colors\":[\"#3f3f46\",\"#27272a\",\"#18181b\"],\"locations\":[0,0.5,1],\"startX\":0,\"startY\":0,\"endX\":1,\"endY\":1}},\"stroke\":\"#ffffff40\",\"strokeWidth\":1.5}}"

component TeardropMarker
  column key="pin:{pin.id}" width=w height=outer map_latitude=pin.lat map_longitude=pin.lng
    column key="place:{pin.id}" pressable=true width=w height=h
      native "shape" absolute=true top=0 left=0 width=w height=h native_props=look
      row absolute=true top=0 left=0 width=w height=w .center
        use Icon name="fork.knife" size=icon_size color="#ffffff"

# The router's open pages (views/pages/), each shown natively over the map
# and sheet and the page before: it grows out of its card for transition
# "zoom", and dragging it down closes it (`dismiss`).
component PageHost
  native "page" key=page.key absolute=true top=0 left=0 width=-1 height=-1 native_props=page.props
    if page.page == "RestaurantPage"
      use RestaurantPage place=page.restaurant
    if page.page == "SavedPage"
      use SavedPage saved=page.saved
    if page.page == "SettingsPage"
      use SettingsPage settings=page.settings
