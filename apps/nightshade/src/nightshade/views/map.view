# The map screen: map with markers, result cards, and the search sheet.
component MapScreen
  column width=-1 height=-1 bg=BG
    map key="map" width=-1 height=-1 bg="#101826" test_id="nightshade-map" map_latitude=region.lat map_longitude=region.lng map_latitude_delta=region.lat_delta map_longitude_delta=region.lng_delta map_markers=region.markers map_dark=true map_shows_user=true
    if carousel
      use Carousel carousel=carousel
    use Sheet sheet=sheet
